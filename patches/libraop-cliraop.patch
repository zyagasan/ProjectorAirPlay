+				ssize_t r = read(infile, trash, avail < (int) sizeof(trash) ? avail : (int) sizeof(trash));
+				if (r <= 0) break;
+				dropped += (int) r;
+			}
+			LOG_INFO("discarded %d bytes of startup backlog (%d ms)", dropped, dropped / 4 * 1000 / 44100);
+		}
+	}
