 	init_platform(interactive);
 
+	// stdin: wait for the first chunk of audio BEFORE starting the RAOP session, otherwise the
+	// stream clock starts running while the source is still warming up and early audio is late
+	uint8_t *first = NULL;
+	int first_n = 0;
+	if (!strcmp(fname, "-")) {
+		size_t want = DEFAULT_FRAMES_PER_CHUNK * 4, got = 0;
+		first = malloc(want);
+		while (got < want) {
+			ssize_t r = read(infile, first + got, want - got);
+			if (r <= 0) break;
+			got += r;
+		}
+		first_n = (int) got;
+		if (!first_n) { free(first); close_platform(interactive); return 0; }
+
+		// the source queues audio while it starts up and then delivers it in a burst; that backlog
+		// would stay as permanent extra latency, so discard whatever is already waiting (max ~1.5s)
+		{
